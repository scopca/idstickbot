# Get a token from @BotFather, then save this file as ".env" with your real token.
BOT_TOKEN=123456789:AAA-your-botfather-token-here

# Optional — Supabase (for persistent language prefs on Render).
# Leave empty to use local file storage. Do NOT commit real values.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-publishable-key
SUPABASE_URL=
SUPABASE_KEY=

# Optional — Render provides PORT automatically. Local default 8080 for health check.
# PORT=8080

# Optional — drop queued updates on restart (default: false)
# DROP_PENDING_UPDATES=false
